{% extends "base.html.j2" %}

{% block title %}About — Horizon Foundation{% endblock %}

{% block content %}
<section class="section-pad">
    <div class="wrap">
        <p class="eyebrow">About Horizon</p>
        <h1 style="max-width: 18ch; margin-bottom: var(--hf-px-5); font-style: italic; font-weight: 300;">Built around the people we work alongside.</h1>
        <p class="lead" style="max-width: 60ch; font-size: 1.4rem;">Founded in {{ profile.founded or 2012 }} as a small grants-dependent collective. Now a registered DGR community foundation working across metropolitan and regional Western Australia.</p>
    </div>
</section>

<section class="section-pad" style="background: var(--hf-bg-2); border-top: 1px solid var(--hf-line); border-bottom: 1px solid var(--hf-line);">
    <div class="wrap">
        <div class="section-header">
            <div>
                <p class="eyebrow">Profile</p>
                <h2>Who we are.</h2>
            </div>
            <div class="lead">
                {{ (profile.description or "")|trim }}
            </div>
        </div>

        {% if profile.key_facts %}
        <div class="programs-grid">
            {% for fact in profile.key_facts[:6] %}
            <article class="program">
                <div class="program-num">FACT {{ "%02d"|format(loop.index) }}</div>
                <p style="color: var(--hf-text); font-size: 1.1rem; line-height: 1.5; font-family: var(--hf-font-display); font-style: italic; font-weight: 400;">{{ fact }}</p>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>

<section class="section-pad">
    <div class="wrap">
        <div class="section-header">
            <div>
                <p class="eyebrow">Leadership</p>
                <h2>Who looks after the table.</h2>
            </div>
            <p class="lead">A small team. Most of us came up through programs, volunteering, or community work — and most of us still do some of it.</p>
        </div>

        <div class="programs-grid">
            {% for emp in employees if emp.tier == 'executive' %}
            <article class="program">
                <div class="program-icon">{{ emp.name[0] }}</div>
                <div class="program-num">EXEC {{ "%02d"|format(loop.index) }}</div>
                <h3 style="font-size: 1.35rem;">{{ emp.name }}</h3>
                <p style="color: var(--hf-clay); font-family: var(--hf-font-display); font-style: italic; font-size: 1rem; margin-bottom: var(--hf-px-3);">{{ emp.role }}</p>
                <p>{{ (emp.background or "")[:240] }}{% if (emp.background or "")|length > 240 %}…{% endif %}</p>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<section class="cta-banner">
    <div class="wrap">
        <div class="cta-banner-inner">
            <div>
                <h2>Want to see the work?</h2>
                <p>Twelve programs, four communities of focus, one long table. The programs page is where the real work lives.</p>
            </div>
            <a href="/programs.html" class="btn btn-primary btn-arrow cta-banner-btn">Programs</a>
        </div>
    </div>
</section>
{% endblock %}
