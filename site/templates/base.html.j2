<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Horizon Foundation — Strengthening Communities Across Western Australia{% endblock %}</title>
    <meta name="description" content="{% block description %}Horizon Foundation is a Western Australian community foundation supporting youth employment, digital literacy for seniors, community health, and emergency relief.{% endblock %}">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="stylesheet" href="/styles/main.css">
    {% block head_extra %}{% endblock %}
</head>
<body>
    <header class="header">
        <div class="header-inner">
            <a href="/" class="brand">
                <div class="brand-logo">H</div>
                <div class="brand-name">
                    <strong>Horizon Foundation</strong>
                    <span>Community / DGR / Perth WA</span>
                </div>
            </a>
            <nav class="nav">
                <a href="/" class="{% if page == 'index' %}active{% endif %}">Home</a>
                <a href="/about.html" class="{% if page == 'about' %}active{% endif %}">About</a>
                <a href="/programs.html" class="{% if page == 'programs' %}active{% endif %}">Programs</a>
                <a href="/careers.html" class="{% if page == 'careers' %}active{% endif %}">Careers</a>
                <a href="/contact.html" class="{% if page == 'contact' %}active{% endif %}">Contact</a>
                <a href="/contact.html" class="nav-cta">Donate</a>
            </nav>
        </div>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="wrap">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h3>Horizon Foundation</h3>
                    <p>A Western Australian community foundation working alongside the people and places that shape our state. Twelve programs, eighty-five volunteers, and a long table that grows every year.</p>
                    <div style="margin-top: var(--hf-px-3);">
                        <span class="dgr-badge">DGR endorsed</span>
                    </div>
                </div>
                <div class="footer-col">
                    <h4>Foundation</h4>
                    <ul>
                        <li><a href="/about.html">Who we are</a></li>
                        <li><a href="/programs.html">Programs</a></li>
                        <li><a href="/careers.html">Careers</a></li>
                        <li><a href="/contact.html">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>For Staff</h4>
                    <ul>
                        <li><a href="/staff/">Staff portal</a></li>
                        <li><a href="/staff/directory.html">Directory</a></li>
                        <li><a href="/staff/documents.html">Documents</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Support us</h4>
                    <ul>
                        <li><a href="/contact.html">Give once</a></li>
                        <li><a href="/contact.html">Give monthly</a></li>
                        <li><a href="/contact.html">Volunteer</a></li>
                        <li><a href="/contact.html">Partner with us</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; {{ year }} Horizon Foundation Ltd / ABN 00 000 000 000 / ACNC registered charity</p>
                <p class="footer-disclaimer">A fictional organisation, made for a Curtin University internship simulation.</p>
            </div>
        </div>
    </footer>
{% if chatbot_embed_id %}
<!-- AnythingLLM hiring desk chatbot -->
<script
  data-embed-id="{{ chatbot_embed_id }}"
  data-base-api-url="{{ chatbot_base_api_url }}"
  src="{{ chatbot_widget_src }}">
</script>
{% endif %}
</body>
</html>
