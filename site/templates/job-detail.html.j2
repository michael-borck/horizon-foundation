{% extends "base.html.j2" %}

{% block title %}{{ job.title }} — Horizon Foundation Careers{% endblock %}

{% block content %}
<section class="section-pad">
    <div class="wrap">
        <p class="eyebrow"><a href="/careers.html" style="color: var(--hf-clay);">← All roles</a> / {{ job.department or "Open role" }}</p>
        <h1 style="max-width: 18ch; margin-bottom: var(--hf-px-5); font-style: italic; font-weight: 300;">{{ job.title }}</h1>
        <p class="lead" style="max-width: 60ch; font-size: 1.25rem;">{{ job.brief or job.summary or "" }}</p>

        <div class="programs-grid" style="margin-top: var(--hf-px-6);">
            <article class="program">
                <div class="program-num">DEPARTMENT</div>
                <h3 style="font-size: 1.35rem;">{{ job.department or "—" }}</h3>
            </article>
            <article class="program">
                <div class="program-num">EMPLOYMENT TYPE</div>
                <h3 style="font-size: 1.35rem;">{{ job.employment_type or "Full-time" }}</h3>
            </article>
            <article class="program">
                <div class="program-num">REPORTS TO</div>
                <h3 style="font-size: 1.35rem;">{{ job.reports_to or "—" }}</h3>
            </article>
        </div>
    </div>
</section>

<section class="section-pad" style="background: var(--hf-bg-2); border-top: 1px solid var(--hf-line); border-bottom: 1px solid var(--hf-line);">
    <div class="wrap-narrow">
        {% if job.description %}
        <article class="prose">
            {{ job.description | markdown }}
        </article>
        {% endif %}
    </div>
</section>

<section class="apply-section" id="apply">
    <div class="wrap">
        <p class="eyebrow">Apply for this role</p>
        <h2 style="font-style: italic; font-weight: 300;">Pull up a chair.</h2>
        <p class="lead">Send us your CV and a note about why this matters to you. We read every application ourselves.</p>

        <form id="apply-form" class="apply-form" data-api-base="https://workready-api.eduserver.au">
            <input type="hidden" name="posting_id" value="">
            <input type="hidden" name="job_title" value="{{ job.title }}">
            <div>
                <label for="applicant_name">Full name <span class="apply-required">*</span></label>
                <input type="text" name="applicant_name" id="applicant_name" required>
            </div>
            <div>
                <label for="applicant_email">Email address <span class="apply-required">*</span></label>
                <input type="email" name="applicant_email" id="applicant_email" required placeholder="firstname.lastname@student.curtin.edu.au">
            </div>
            <div>
                <label for="cover_letter">Cover letter</label>
                <textarea name="cover_letter" id="cover_letter" rows="5" placeholder="Tell us why you're a good fit for this role…"></textarea>
            </div>
            <div>
                <label for="resume">Resume (PDF) <span class="apply-required">*</span></label>
                <input type="file" name="resume" id="resume" accept=".pdf" required>
            </div>
            <div>
                <button type="submit" class="btn btn-primary btn-arrow">Submit application</button>
            </div>
            <div id="apply-result" class="apply-result"></div>
        </form>
    </div>
</section>
{% endblock %}

{% block head_extra %}
<script src="/scripts/apply.js" defer></script>
{% endblock %}
