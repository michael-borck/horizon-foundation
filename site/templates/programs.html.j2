{% extends "base.html.j2" %}

{% block title %}Programs — Horizon Foundation{% endblock %}

{% block content %}
<section class="section-pad">
    <div class="wrap">
        <p class="eyebrow">Our programs</p>
        <h1 style="max-width: 18ch; margin-bottom: var(--hf-px-5); font-style: italic; font-weight: 300;">Six areas of work. Twelve programs. One way of doing things.</h1>
        <p class="lead" style="max-width: 60ch; font-size: 1.35rem;">We work where we're invited and we stay until the work is finished — or until the community is ready to carry it themselves.</p>
    </div>
</section>

<section class="section-pad-sm" style="background: var(--hf-bg-2); border-top: 1px solid var(--hf-line); border-bottom: 1px solid var(--hf-line);">
    <div class="wrap">
        <div class="programs-grid">
            {% for svc in (profile.services or [])[:6] %}
            <article class="program">
                <div class="program-icon">{{ svc[0] }}</div>
                <div class="program-num">AREA {{ "%02d"|format(loop.index) }}</div>
                <h3 style="font-size: 1.35rem;">{{ svc }}</h3>
                <p>Co-designed with the communities we work alongside, delivered by a mix of paid program staff and trained volunteers, and reported on with both numbers and stories.</p>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<section class="impact">
    <div class="wrap">
        <div class="impact-header">
            <p class="eyebrow">Reach across WA</p>
            <h2>Where the work lands.</h2>
        </div>
        <div class="impact-grid">
            <div class="impact-stat">
                <div class="impact-num">4,200</div>
                <div class="impact-label">Direct beneficiaries /yr</div>
            </div>
            <div class="impact-stat">
                <div class="impact-num">12</div>
                <div class="impact-label">Active programs</div>
            </div>
            <div class="impact-stat">
                <div class="impact-num">38</div>
                <div class="impact-label">Delivery venues</div>
            </div>
            <div class="impact-stat">
                <div class="impact-num">9</div>
                <div class="impact-label">Regional communities</div>
            </div>
        </div>
    </div>
</section>

<section class="section-pad">
    <div class="wrap">
        <div class="section-header">
            <div>
                <p class="eyebrow">How we work</p>
                <h2>Three things we always do.</h2>
            </div>
            <p class="lead">Process matters as much as outcomes. The how is the work, not the wrapper around it.</p>
        </div>

        <div class="programs-grid">
            <article class="program">
                <div class="program-icon">1</div>
                <div class="program-num">PRINCIPLE 01</div>
                <h3>Listen first.</h3>
                <p>Every program begins with months of listening. Community voice isn't a consultation phase — it's where the work starts and where it returns whenever a decision matters.</p>
            </article>
            <article class="program">
                <div class="program-icon">2</div>
                <div class="program-num">PRINCIPLE 02</div>
                <h3>Stay grounded.</h3>
                <p>Our programs don't scale by simply adding more participants. They scale by going deeper, training more volunteers from the community, and handing ownership back when it's time.</p>
            </article>
            <article class="program">
                <div class="program-icon">3</div>
                <div class="program-num">PRINCIPLE 03</div>
                <h3>Tell true stories.</h3>
                <p>We measure what matters and we report honestly — including what didn't work. Donors and grant makers deserve the same truth communities do.</p>
            </article>
        </div>
    </div>
</section>
{% endblock %}
